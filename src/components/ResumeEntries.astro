---
import type { ResumeEntry } from '../data/resume';

interface Props {
  entries: ResumeEntry[];
}

const { entries } = Astro.props;
---

<ul class="entries">
  {
    entries.map((entry) => (
      <li class="entry">
        <div class="main">
          <span class="title">
            {entry.title}
            {entry.note && <span class="note"> {entry.note}</span>}
          </span>
          {entry.organisation && <span class="org">{entry.organisation}</span>}
        </div>
        {entry.dates && <span class="dates">{entry.dates}</span>}
        {
          entry.steps && (
            <ol class="steps" aria-label="Promotions">
              {entry.steps.map((step) => (
                <li class="step">
                  <span class="step-title">{step.title}</span>
                  {step.dates && <span class="step-dates">{step.dates}</span>}
                </li>
              ))}
            </ol>
          )
        }
        {entry.content?.map((block) =>
          typeof block === 'string' ? (
            <p class="detail">{block}</p>
          ) : (
            <ul class="detail">
              {block.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ),
        )}
      </li>
    ))
  }
</ul>

<style>
  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .entry:first-child {
    padding-top: 0;
  }

  .entry:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .main {
    display: flex;
    flex-direction: column;
  }

  .title {
    font-weight: 500;
  }

  .note {
    font-weight: 400;
  }

  .org,
  .dates {
    font-size: 0.9375rem;
    color: #6c757d;
  }

  .dates {
    white-space: nowrap;
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    flex-basis: 100%;
    gap: 0 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .step + .step::before {
    content: '→';
    margin-right: 0.5rem;
    color: #6c757d;
  }

  .step-title {
    font-weight: 500;
  }

  .step-dates {
    margin-left: 0.25rem;
    color: #6c757d;
  }

  .detail {
    flex-basis: 100%;
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    font-weight: 300;
  }
</style>
