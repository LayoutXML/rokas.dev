---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, links, playBadgeUrl, publications } = project.data;
const { Content } = await render(project);

const linkKinds = {
  github: { icon: 'github', label: 'Source Code (GitHub)' },
  'google-play': { icon: 'google-play', label: 'Google Play' },
  'docker-hub': { icon: 'docker', label: 'Docker Hub' },
  website: { icon: 'globe', label: 'External Website' },
};
---

<dialog class="dialog" id={`project-${project.id}`} data-slug={project.id} aria-labelledby={`project-${project.id}-title`}>
  <div class="header">
    <h1 class="title" id={`project-${project.id}-title`}>{title}</h1>
    <form method="dialog">
      <button class="close" aria-label="Close"><Icon name="times" /></button>
    </form>
  </div>

  <div class="layout">
    <div class="card description">
      <h5 class="card-header">Description</h5>
      <div class="card-body prose">
        <Content />
      </div>
    </div>

    <div class="aside">
      {
        links.length > 0 && (
          <div class="card">
            <h5 class="card-header">Links</h5>
            <div class="card-body">
              {links.map((link) => (
                <p>
                  <a href={link.url}>
                    <Icon name={linkKinds[link.kind].icon} class="link-icon" />
                    {linkKinds[link.kind].label}
                  </a>
                </p>
              ))}
              {playBadgeUrl && (
                <>
                  <a href={playBadgeUrl}>
                    <img
                      alt="Get it on Google Play"
                      src="https://play.google.com/intl/en_us/badges/images/generic/en_badge_web_generic.png"
                      loading="lazy"
                    />
                  </a>
                  <p class="play-legal">Google Play and the Google Play logo are trademarks of Google LLC.</p>
                </>
              )}
            </div>
          </div>
        )
      }

      {
        publications.length > 0 && (
          <div class="card">
            <h5 class="card-header">Featured in</h5>
            <div class="card-body">
              <div class="badges">
                {publications.map((publication) => (
                  <a href={publication.url}>
                    <Image src={publication.badge} width={180} densities={[1, 2]} alt={publication.outlet} />
                  </a>
                ))}
              </div>
              {publications.map((publication) => (
                <p class="publication">
                  <a href={publication.url}>{`${publication.outlet}: "${publication.article}"`}</a>
                  {publication.archive && (
                    <span>
                      {' '}(<a href={publication.archive}>Archive</a>)
                    </span>
                  )}
                </p>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</dialog>

<style>
  .dialog {
    width: calc(100% - 1rem);
    max-width: 1140px;
    max-height: calc(100% - 2rem);
    padding: 1.5rem 15px;
    color: var(--color-text);
    border: none;
    border-radius: var(--radius-card);
  }

  .dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .title {
    margin: 0;
  }

  .close {
    padding: 0.25rem 0.5rem;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-text);
    background: none;
    border: none;
    opacity: 0.5;
    cursor: pointer;
  }
  .close:hover {
    opacity: 0.75;
  }

  .layout {
    display: grid;
    gap: 1rem 30px;
  }

  .aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .description .card-body {
    padding: 1.5rem;
  }

  :global(.link-icon) {
    margin-right: 0.5rem;
  }

  .play-legal {
    color: #9e9e9e;
    font-weight: 300;
  }

  .badges {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1rem;
    padding: 0 15px;
  }

  .badges img {
    max-width: min(100%, 180px);
    margin-bottom: 1rem;
  }

  .publication {
    font-weight: 700;
  }

  .prose :global(> :last-child) {
    margin-bottom: 0;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0 0.25rem;
  }

  .prose :global(pre) {
    overflow-x: auto;
  }

  @media (min-width: 768px) {
    .dialog {
      width: calc(100% - 4rem);
      padding: 1.5rem 30px;
    }

    .layout {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }
</style>
