---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { site } from '../data/site';
import ProjectCard from './ProjectCard.astro';
import ProjectDialog from './ProjectDialog.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const groups = [
  { title: 'Featured', featured: true },
  { title: 'More projects', featured: false },
]
  .map((group) => ({ ...group, projects: projects.filter((project) => project.data.featured === group.featured) }))
  .filter((group) => group.projects.length > 0);
---

<section id="projects">
  <div class="container">
    <h2 class="heading">Projects</h2>

    {
      groups.map((group) => (
        <h3 class="group-title">{group.title}</h3>
        <div class:list={['grid', { featured: group.featured }]}>
          {group.projects.map((project) => <ProjectCard project={project} variant={group.featured ? 'feature' : 'compact'} />)}
        </div>
      ))
    }

    <p class="more no-print">
      <a class="btn-outline" href={site.github}><Icon name="github" /> More projects on GitHub</a>
    </p>
  </div>

  {projects.filter((project) => !project.data.externalUrl).map((project) => <ProjectDialog project={project} />)}
</section>

<style>
  .heading {
    margin-top: 1rem;
  }

  .group-title {
    margin: 2rem 0 0;
    font-size: 1.25rem;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .more {
    margin: 2rem 0 0;
  }
</style>
