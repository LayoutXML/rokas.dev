---
// Old project pages (/projects/<id>/) redirect to the project's popup on the home page
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (project) => !project.data.externalUrl);
  const current = projects.map((project) => ({ params: { slug: project.id }, props: { title: project.data.title, target: `/#${project.id}` } }));
  // Projects removed from the site still keep their old URLs working
  const retired = [
    { slug: 'rental-store', title: 'Rental Store Mock API' },
    { slug: 'dont-stop-moving', title: "Don't stop moving! The game" },
    { slug: 'website', title: 'This website' },
  ].map(({ slug, title }) => ({ params: { slug }, props: { title, target: '/#projects' } }));
  return [...current, ...retired];
}

const { title, target } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} | Rokas Jankunas</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <a href={target}>{title}</a>
  </body>
</html>
